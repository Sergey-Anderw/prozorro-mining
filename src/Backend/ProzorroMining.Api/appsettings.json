{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Postgres": {
    "ConnectionTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 30,
    "MinimumPoolSize": 0,
    "MaximumPoolSize": 100,
    "KeepAliveSeconds": 30
  },
  "Prozorro": {
    "ApiUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "DefaultPageSize": 100,
    "Retry": {
      "MaxAttempts": 3,
      "BaseDelaySeconds": 2
    }
  },
  "Cache": {
    "Enabled": false,
    "DurationSeconds": 300
  },
  "AllowedHosts": "*"
}
