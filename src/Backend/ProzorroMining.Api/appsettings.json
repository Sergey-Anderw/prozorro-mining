{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Postgres": {
    "ConnectionTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 30,
    "MinimumPoolSize": 0,
    "MaximumPoolSize": 100,
    "KeepAliveSeconds": 30
  },
  "Prozorro": {
    "ApiUrl": "https://public-api.prozorro.gov.ua/api/2.5/",
    "TimeoutSeconds": 30,
    "Retry": {
      "MaxAttempts": 3,
      "BaseDelaySeconds": 2
    },
    "DetailRateLimit": {
      "RequestsPerSecond": 8,
      "QueueLimit": 32
    }
  },
  "AllowedHosts": "*"
}
